# Base de donnees Postgres
DATABASE_URI=postgres://postgres:postgres@localhost:5432/demo_boulangerie

# Cle de chiffrement Payload : generer avec `openssl rand -base64 32`
PAYLOAD_SECRET=a-remplacer-par-une-cle-aleatoire

# URL publique du site, sans slash final
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret de la previsualisation. A defaut, PAYLOAD_SECRET est utilise.
PREVIEW_SECRET=

# --- Module de commande (facultatif) ---
#
# Deux modes de paiement en ligne, qui s'excluent.
#
# 1. Stripe Connect (recommandé en agence) : renseigner CLIENT_ID. Le commerçant
#    lie son compte lui-même depuis l'administration, aucune clé de sa part ne
#    circule. STRIPE_SECRET_KEY est alors la clé de la PLATEFORME de l'agence,
#    la même pour tous les sites.
# 2. Clé directe (site isolé, développement) : laisser CLIENT_ID vide.
#    STRIPE_SECRET_KEY est la clé du commerçant lui-même.
#
# Si CLIENT_ID est renseigné, aucun repli sur la clé directe n'a lieu : sans
# compte lié, le paiement en ligne reste indisponible. C'est délibéré — le repli
# enverrait les encaissements sur le compte de l'agence.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
# Secret du point de terminaison webhook (événements Connect en mode plateforme)
STRIPE_WEBHOOK_SECRET=

# Resend : envoi des e-mails de confirmation
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié chez Resend
EMAIL_EXPEDITEUR=Boulangerie Martin <commandes@exemple.fr>
