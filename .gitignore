# Dépendances
node_modules/

# Build
.next/
dist/
*.tsbuildinfo
next-env.d.ts

# Environnement
#
# Tout fichier d'environnement est ignoré, y compris les copies de travail et
# les sauvegardes : un « .env.backup » s'est déjà glissé dans l'historique, et
# le supprimer ensuite n'en efface pas le contenu.
#
# Seuls les modèles des apps échappent à la règle : ils ne contiennent que des
# valeurs d'exemple.
.env
.env.*
!apps/*/.env.example

# Médias téléversés : ils vivent sur le volume persistant du serveur,
# pas dans le dépôt.
apps/*/public/media/

# Système
.DS_Store
